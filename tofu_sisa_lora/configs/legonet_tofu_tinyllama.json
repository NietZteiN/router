{
  "name": "legonet_tofu_tinyllama_n32_k3",
  "comment": "Cross-model smoke: LegoNet-on-TOFU on TinyLlama-1.1B, identical 6ep vanilla n=32/k=3 recipe as legonet_tofu.json (Llama-2-7B) and legonet_tofu_llama3p2_1b.json, for an apples-to-apples cross-model table vs the base-model baseline.",
  "base_model": "TinyLlama/TinyLlama-1.1B-Chat-v1.0",
  "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
  "n": 32,
  "k": 3,
  "route_on": "answer",
  "balanced": false,
  "lora": {
    "rank": 16,
    "alpha": 32,
    "dropout": 0.0,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "use_rslora": false
  },
  "train": {
    "epochs": 6,
    "lr": 2e-4,
    "batch_size": 1,
    "grad_accum": 8,
    "max_length": 256
  },
  "base_seed": 42,
  "kmeans_seed": 42,
  "num_authors": 200,
  "records_per_author": 20,
  "forget_authors": [180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199],
  "output_dir": "${TOFU_CKPT_ROOT}/TinyLlama-1.1B-Chat-v1.0_legonet_n32_k3",
  "hf_home": "${HF_HOME}"
}
