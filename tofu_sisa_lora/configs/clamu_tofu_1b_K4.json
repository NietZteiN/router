{
  "method": "clamu",
  "comment": "K-dial (E4/H5) point K=4: reuses the K=16 build's tau_bar via symlink (K-independent), re-clusters + STE-localizes only. heuristic_masks off (EMR/TALL already characterized at K=16); mask_epochs=4 equalizes mask training across K (fixed mask_steps would confound the dial).",
  "model_name": "meta-llama/Llama-3.2-1B-Instruct",
  "output_dir": "./checkpoints/Llama-3.2-1B-Instruct_clamu_K4",
  "hf_home": "${HF_HOME}",
  "num_authors": 200,
  "records_per_author": 20,
  "steps": 20,
  "lr": 0.0001,
  "max_length": 256,
  "loss_on": "answer",
  "seed": 42,
  "frozen_substr": [
    "embed_tokens",
    "lm_head"
  ],
  "num_clusters": 4,
  "cluster_affinity": "feature",
  "encoder_model": "sentence-transformers/all-MiniLM-L6-v2",
  "route_on": "answer",
  "kmeans_seed": 42,
  "mask_lr": 0.05,
  "mask_opt_seed": 42,
  "mask_batch_rows": 8,
  "mask_log_every": 0,
  "tall_lambda": 0.4,
  "unlearn_tags": {
    "forget10": [
      180,
      181,
      182,
      183,
      184,
      185,
      186,
      187,
      188,
      189,
      190,
      191,
      192,
      193,
      194,
      195,
      196,
      197,
      198,
      199
    ]
  },
  "heuristic_masks": false,
  "mask_epochs": 4
}