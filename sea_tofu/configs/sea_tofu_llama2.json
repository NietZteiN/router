{
  "comment": "SEA-on-TOFU minimal-faithful config. Frozen 4-bit NF4 base + per-author personal LoRA (SFT). See ~/SEA_on_TOFU.md and ~/.claude/plans/let-s-plan-to-implement-gleaming-dahl.md.",
  "model_name": "meta-llama/Llama-2-7B-chat-hf",
  "quantization": {
    "load_in_4bit": true,
    "bnb_4bit_quant_type": "nf4",
    "bnb_4bit_compute_dtype": "bfloat16",
    "bnb_4bit_use_double_quant": true
  },
  "personal_lora": {
    "rank": 16,
    "alpha_mult": 2,
    "lora_dropout": 0.05,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "use_rslora": true,
    "bias": "none"
  },
  "train": {
    "epochs": 12,
    "lr": 2e-4,
    "batch_size": 4,
    "grad_accum": 1,
    "max_length": 256,
    "lr_scheduler_type": "cosine",
    "warmup_ratio": 0.03,
    "weight_decay": 0.001,
    "max_grad_norm": 0.3,
    "optim": "paged_adamw_32bit",
    "seed": 42
  },
  "rank_sweep": [4, 8, 16, 32, 64],
  "splits": {
    "forget10_authors": [180, 181, 182, 183, 184, 185, 186, 187, 188, 189, 190, 191, 192, 193, 194, 195, 196, 197, 198, 199]
  },
  "deletion": {
    "tau_min": 0.15,
    "kl_mult": 2.0,
    "n_generic_prompts": 40
  }
}
